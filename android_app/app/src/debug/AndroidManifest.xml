<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <receiver
            android:name=".TestTransactionReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="z.zndroid.debug.BEGIN_TEST_TX" />
                <action android:name="z.zndroid.debug.END_TEST_TX_ROLLBACK" />
                <action android:name="z.zndroid.debug.END_TEST_TX_COMMIT" />
                <action android:name="z.zndroid.debug.CHECK_SYNC" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".TestNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="z.zndroid.debug.NOTIFY_TEST_DONE" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
