[
  {
    "name": "simple link",
    "input": "see [[Cats|p123]] here",
    "expected": [["Cats", "p123"]]
  },
  {
    "name": "title containing pipe",
    "input": "see [[Cats | Dogs | Birds|p123]]!",
    "expected": [["Cats | Dogs | Birds", "p123"]]
  },
  {
    "name": "emoji title",
    "input": "[[🐱 Cats 👨‍👩‍👧‍👦|page_emoji]]",
    "expected": [["🐱 Cats 👨‍👩‍👧‍👦", "page_emoji"]]
  },
  {
    "name": "two adjacent tokens",
    "input": "[[One|id1]][[Two|id2]]",
    "expected": [["One", "id1"], ["Two", "id2"]]
  },
  {
    "name": "two tokens with text between",
    "input": "[[One|id1]] and [[Two|id2]]",
    "expected": [["One", "id1"], ["Two", "id2"]]
  },
  {
    "name": "missing id (no pipe)",
    "input": "[[Cats]]",
    "expected": []
  },
  {
    "name": "empty id (trailing pipe)",
    "input": "[[Cats|]]",
    "expected": []
  },
  {
    "name": "empty title",
    "input": "[[|p123]]",
    "expected": []
  },
  {
    "name": "id with a space (not a link)",
    "input": "[[Cats|bad id]]",
    "expected": []
  },
  {
    "name": "id with tab (not a link)",
    "input": "[[Cats|bad\tid]]",
    "expected": []
  },
  {
    "name": "newline inside token (not a link)",
    "input": "[[Cats\nDogs|p123]]",
    "expected": []
  },
  {
    "name": "trailing extra closing bracket [[a|b]]]",
    "input": "[[a|b]]]",
    "expected": [["a", "b"]]
  },
  {
    "name": "nested brackets containing closing bracket",
    "input": "[[foo [bar]|p123]]",
    "expected": []
  },
  {
    "name": "extra leading bracket [[[a|b]]",
    "input": "[[[a|b]]",
    "expected": [["[a", "b"]]
  },
  {
    "name": "invalid link followed by valid link",
    "input": "[[bad|with space]] then [[Good|p2]]",
    "expected": [["Good", "p2"]]
  }
]
